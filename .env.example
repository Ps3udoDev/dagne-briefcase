# ==============================================================================
# Psicoiris — Variables de Entorno (Plantilla .env.example)
# ==============================================================================
# Copia este archivo a:
#   - .env.local (en la raíz o en apps/web/.env.local y apps/dashboard/.env.local)
# Nunca subas .env, .env.local ni claves privadas al repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Requerido para Landing, Dashboard, Auth y Storage)
# ------------------------------------------------------------------------------
# URL del proyecto en Supabase (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROJECT-REF.supabase.co"

# Clave pública anónima (Settings -> API -> anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Clave privada de servicio (SOLO servidor / migraciones / scripts — NUNCA exponer en cliente)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ID / Reference del proyecto para Supabase CLI (`supabase link --project-ref ...`)
SUPABASE_PROJECT_REF="tu-project-ref"

# Contraseña de la base de datos (opcional, solo si ejecutas `supabase db push` directo)
# SUPABASE_DB_PASSWORD=""

# ------------------------------------------------------------------------------
# 2. URLs de las Aplicaciones (Monorepo)
# ------------------------------------------------------------------------------
# URL pública del portafolio / landing
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# URL del dashboard administrativo / CRM
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3001"

# ------------------------------------------------------------------------------
# 3. Configuración Clínica / Profesional Inicial
# ------------------------------------------------------------------------------
# Correo del psicólogo propietario autorizado para el dashboard inicial
CLINICIAN_ADMIN_EMAIL="dagneraza123@gmail.com"

# ------------------------------------------------------------------------------
# 4. Revalidación On-Demand (Dashboard -> Landing ISR)
# ------------------------------------------------------------------------------
# Token secreto compartido para revalidar la landing automáticamente al guardar posts o perfil
REVALIDATION_SECRET="genera-un-token-aleatorio-seguro"

# ------------------------------------------------------------------------------
# 5. Integraciones Futuras (Fase 2+ — Opcional por ahora)
# ------------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM=""
# OPENAI_API_KEY=""
