{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "dashboard": {
      "root": "apps/dashboard",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "web",
          "format": "url",
          "env": "WEB_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": {
        "service": "dashboard"
      }
    },
    {
      "source": "/dashboard/(.*)",
      "destination": {
        "service": "dashboard"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
